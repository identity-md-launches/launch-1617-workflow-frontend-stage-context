{
  "name": "imd-pepe-risk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/manifest.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node scripts/browser-test.mjs",
    "check:export": "node scripts/manifest.mjs --check",
    "art:cover": "tsx scripts/cover.tsx",
    "format": "prettier --write src scripts tests index.html play.html vite.config.ts"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "viem": "2.38.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "sharp": "0.34.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
